{
  "name": "leukonet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "A swarm of AI sentinel agents that catches scams on NEAR in real time and publishes staked verdicts to an onchain registry.",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.9",
    "near-api-js": "^7.4.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "scripts": {
    "setup": "tsx src/scripts/setup.ts",
    "start": "tsx src/main.ts",
    "deploy": "tsx src/scripts/deploy.ts",
    "attack": "tsx src/sim/cli.ts",
    "check": "tsx src/sdk/cli.ts",
    "example:guarded-agent": "tsx examples/guarded-agent.ts",
    "test": "cd contracts/registry && cargo test && cd ../.. && tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dev:web": "vite web",
    "build:web": "vite build web",
    "export-env": "tsx src/scripts/export-env.ts",
    "mcp": "tsx src/mcp/stdio.ts",
    "sentinel": "tsx src/operator/run.ts",
    "build:extension": "node extension/build.mjs && python3 -c \"import shutil; shutil.make_archive('web/public/leukonet-guard', 'zip', 'extension/dist')\""
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.4.5"
  }
}
