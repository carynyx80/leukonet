# Written by `npm run setup`. You normally do not edit these.
LEUKONET_MASTER=
LEUKONET_REGISTRY=

# Optional: plain-English explanations from NEAR AI Cloud (https://cloud.near.ai).
# Without a key, sentinels use the detector's own one-line reason.
NEAR_AI_API_KEY=
# NEAR_AI_MODEL=anthropic/claude-haiku-5-5

# Optional
# PORT=8787
# DEMO_CONTROLS=1        # show the attack buttons
# NORMAL_TRAFFIC=1       # background payroll traffic for the demo
# WATCH_MAINNET=1        # also scan mainnet, read-only (never writes)
# FLAG_SCOPE=demo        # "all" lets sentinels stake on any testnet account
# NEAR_RPC_URL=https://rpc.testnet.fastnear.com
# NEAR_DATA_URL=https://testnet.neardata.xyz
